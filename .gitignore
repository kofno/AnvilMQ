# Rust build output (keep Cargo.lock tracked for this application).
/target/
**/node_modules/
**/*.rs.bk

# Local daemon database and SQLite sidecar files.
/anvil.db
/anvil.db-wal
/anvil.db-shm
/anvil.db-journal

# Local environment settings; allow documented examples.
.env
.env.*
!.env.example
!.env.*.example

# Editor temporary files and operating-system metadata.
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

    {
      "id": 8,
      "title": "Enqueue-rejection logs (broker)",
      "description": "Broker warn logs for every rejected enqueue, from Loki: {compose_service=\"broker\"} |= \"enqueue rejected\". Covers ingress velocity, the depth circuit breaker, inconsistent depth, missing parent, and chain quarantine. Expand a line to see the structured fields (name, trace_id, parent_id, execution_depth) that identify the offending job/lineage. Use Explore for ad-hoc LogQL (e.g. add `| json | name=\"RecursiveProbe\"`).",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 11
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_service=\"broker\"} |= \"enqueue rejected\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 9,
      "title": "Enqueue rejections/sec by kind",
      "description": "Per-kind admission-time enqueue rejection rate from anvilmq_enqueue_rejections_total. Covers all five kinds (ingress_velocity, parent_not_found, inconsistent_depth, circuit_breaker, chain_quarantine). Unlike the older aggregate counters, this splits by kind so you can tell recursion breakers from ingress throttles at a glance.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 8

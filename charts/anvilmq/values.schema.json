{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "durability", "persistence", "networkPolicy"],
  "properties": {
    "replicaCount": { "type": "integer", "enum": [1] },
    "durability": { "type": "string", "enum": ["NORMAL", "FULL"] },
    "logLevel": { "type": "string", "minLength": 1 },
    "metricsQueues": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^,\\s](?:[^,]*[^,\\s])?$" } },
    "image": {
      "type": "object", "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "persistence": {
      "type": "object", "required": ["size", "storageClass"],
      "properties": { "size": { "type": "string", "minLength": 1 }, "storageClass": { "type": "string" } }
    },
    "networkPolicy": {
      "type": "object", "required": ["enabled", "allowedFrom"],
      "properties": { "enabled": { "type": "boolean" }, "allowedFrom": { "type": "array", "minItems": 1, "items": { "type": "object", "minProperties": 1 } } }
    },
    "dashboards": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "folder": { "type": "string" },
        "namespace": { "type": "string" }
      }
    }
  }
}

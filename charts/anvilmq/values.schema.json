{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "durability", "persistence", "networkPolicy"],
  "properties": {
    "replicaCount": { "type": "integer", "enum": [1] },
    "durability": { "type": "string", "enum": ["NORMAL", "FULL"] },
    "logLevel": { "type": "string", "minLength": 1 },
    "metricsQueues": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^,\\s](?:[^,]*[^,\\s])?$" } },
    "engine": {
      "type": "object",
      "description": "Optional broker operational knobs. Empty string / false means use the broker's built-in default; range validation is owned by the binary.",
      "properties": {
        "maxExecutionDepth": { "type": "string", "pattern": "^$|^[0-9]+$" },
        "maxChainSize": { "type": "string", "pattern": "^$|^[0-9]+$" },
        "leaseDurationMs": { "type": "string", "pattern": "^$|^[0-9]+$" },
        "recoveryIntervalMs": { "type": "string", "pattern": "^$|^[0-9]+$" },
        "recoveryBatchSize": { "type": "string", "pattern": "^$|^[0-9]+$" },
        "fairnessEnabled": { "type": "boolean" }
      }
    },
    "image": {
      "type": "object", "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "persistence": {
      "type": "object", "required": ["size", "storageClass"],
      "properties": { "size": { "type": "string", "minLength": 1 }, "storageClass": { "type": "string" } }
    },
    "networkPolicy": {
      "type": "object", "required": ["enabled", "allowedFrom"],
      "properties": { "enabled": { "type": "boolean" }, "allowedFrom": { "type": "array", "minItems": 1, "items": { "type": "object", "minProperties": 1 } } }
    },
    "dashboards": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "folder": { "type": "string" },
        "namespace": { "type": "string" }
      }
    },
    "infinityDatasource": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "sidecarLabel": { "type": "string", "minLength": 1 },
        "sidecarValue": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "intervalMs": { "type": "integer", "minimum": 1 },
        "retain": { "type": "integer", "minimum": 1 },
        "upload": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "account": { "type": "string" },
            "container": { "type": "string" },
            "prefix": { "type": "string" },
            "pollSeconds": { "type": "integer", "minimum": 1 },
            "workloadIdentity": {
              "type": "object",
              "properties": {
                "clientId": { "type": "string" },
                "tenantId": { "type": "string" }
              }
            },
            "resources": { "type": "object" }
          },
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "account": { "type": "string", "minLength": 1 },
              "container": { "type": "string", "minLength": 1 },
              "workloadIdentity": {
                "type": "object",
                "required": ["clientId"],
                "properties": { "clientId": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
